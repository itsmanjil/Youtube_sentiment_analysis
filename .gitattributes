# Auto detect text files and perform LF normalization
* text=auto
backend/models/transformers/deberta_v3/*.pt filter=lfs diff=lfs merge=lfs -text
backend/models/transformers/deberta_v3/*.model filter=lfs diff=lfs merge=lfs -text
backend/models/transformers/deberta_v3/*.safetensors filter=lfs diff=lfs merge=lfs -text
backend/models/transformers/deberta_v3/*.pth filter=lfs diff=lfs merge=lfs -text
backend/models/transformers/deberta_v3/*.bin filter=lfs diff=lfs merge=lfs -text
