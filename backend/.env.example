# Django runtime
DJANGO_ENV=development
SECRET_KEY=replace-me-with-a-random-local-dev-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend dev origin
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional YouTube Data API key
YOUTUBE_API_KEY=

# youtube/analyze/ runs on a Django-Q2 background worker and returns a
# pollable job id by default (see README.md — requires `python manage.py
# qcluster` running separately). Set to true to force the old synchronous
# behavior (e.g. for local debugging without starting a qcluster process).
# ANALYSIS_RUN_SYNC=false
